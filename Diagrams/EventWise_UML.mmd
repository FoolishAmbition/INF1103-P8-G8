%% ====================================================================
%% RELATIONSHIPS
%% ====================================================================

%% ---------- Inheritance (domain entities) ----------
Entity <|-- AIScores
Entity <|-- StudentProfile
Entity <|-- EventRecord

%% ---------- Inheritance (managers) ----------
BaseManager <|-- IOManager
BaseManager <|-- AIManager
BaseManager <|-- DataManager
BaseManager <|-- LogicManager

%% ---------- Inheritance (persistence) ----------
PersistenceStrategy <|-- JsonStorage
PersistenceStrategy <|-- MongoStorage

%% ---------- Inheritance (rules) ----------
Rule <|-- TopScoresRule
Rule <|-- HighValueLowWorkloadRule
Rule <|-- HighValueHighWorkloadRule
Rule <|-- MidValueLowWorkloadRule
Rule <|-- MidValueHighWorkloadRule
Rule <|-- LowValueRule

%% ---------- Inheritance (exceptions) ----------
EventWiseError <|-- APIError
EventWiseError <|-- ResponseValidationError
EventWiseError <|-- DataCorruptionError
EventWiseError <|-- ValidationError
EventWiseError <|-- DatabaseError
EventWiseError <|-- GeoLocationError

%% ---------- Interface realisation ----------
ScoringStrategy <|.. StandardScoringStrategy
TransitRoutingService <|.. GeoLocationService

%% ---------- Composition (owner manages lifecycle) ----------
EventWise "1" *-- "1" Flask : _app
EventRecord "1" *-- "1" AIScores : _ai_scores

%% ---------- Aggregation (part can exist independently) ----------
EventWise "1" o-- "1" IOManager : _io_manager
EventWise "1" o-- "1" AIManager : _ai_manager
EventWise "1" o-- "1" LogicManager : _logic_manager
EventWise "1" o-- "1" DataManager : _data_manager
DataManager "1" o-- "1" PersistenceStrategy : _storage
DataManager "1" o-- "1" EventFilter : _event_filter
DataManager "1" o-- "1" AnalyticsReporter : _analytics_reporter
LogicManager "1" o-- "1" RuleEngine : _rule_engine
LogicManager "1" o-- "1" ScoringStrategy : _scoring
LogicManager "1" o-- "1" JourneyPlanner : _journey_planner
AIManager "1" o-- "1" GeminiClient : _client
AIManager "1" o-- "1" PromptBuilder : _prompt_builder
RuleEngine "1" o-- "1..*" Rule : _rules
JourneyPlanner "1" o-- "0..1" TransitRoutingService : _service

%% ---------- Association (collaboration, no ownership) ----------
EventFilter "1" --> "0..*" EventRecord : filters
AnalyticsReporter "1" --> "0..*" EventRecord : summarises
GeoLocationService --> GeoLocationError : raises

%% ---------- Dependency (managers use/create domain objects) ----------
DataManager ..> StudentProfile : creates/loads
DataManager ..> EventRecord : creates/loads
LogicManager ..> EventRecord : creates
LogicManager ..> StudentProfile : checks
LogicManager ..> TravelResult : coordinates
AIManager ..> AIScores : creates
IOManager ..> EventRecord : formats
IOManager ..> StudentProfile : formats
IOManager ..> TravelResult : sanitizes
JourneyPlanner ..> TravelResult : evaluates/returns
GeoLocationService ..> TravelResult : creates
StudentProfile ..> TransitRoutingService : validates postcode