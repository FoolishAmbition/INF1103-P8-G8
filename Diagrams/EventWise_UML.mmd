classDiagram
direction TB

%% ====================================================================
%% 1. CORE APPLICATION & MANAGERS
%% ====================================================================

class Flask {
    <<framework>>
}

class EventWise {
    -Flask _app
    -IOManager _io_manager
    -AIManager _ai_manager
    -LogicManager _logic_manager
    -DataManager _data_manager
    +app Flask
    +home() Response
    +state() Response
    +save_profile() Response
    +get_events() Response
    +get_analytics() Response
    +analyse() Response
    +close() void
    +run(host: str, port: int, debug: bool) void
}

class BaseManager {
    <<abstract>>
    #str _name
    +name() str
}

class IOManager {
    +render_home() str
    +get_profile_input() tuple
    +get_event_input() tuple
    +get_filter_params() dict
    +send_events(events: list~EventRecord~) Response
    +send_analytics(analytics: dict) Response
    +send_state(profile: StudentProfile, events: list~EventRecord~) Response
    +send_profile(profile: StudentProfile, message: str) Response
    +send_analysis(record: EventRecord, events: list~EventRecord~, travel_result: dict, message: str) Response
    +send_error(message: str, status_code: int) Response
    +send_server_error(exc: Exception) Response
    +sanitize_travel_result(assessment: TravelResult) dict
}

class AIManager {
    -GeminiClient _client
    -PromptBuilder _prompt_builder
    -int _max_retries
    +build_prompt(profile: dict, name: str, description: str) str
    +validate_schema(data: dict) bool
    +parse_response(raw: str) dict
    +analyze_event(profile: dict, name: str, description: str) dict
}

class LogicManager {
    -RuleEngine _rule_engine
    -ScoringStrategy _scoring
    -JourneyPlanner _journey_planner
    +calculate_event_value(ai_scores: AIScores) int
    +event_priority(value: int) str
    +generate_recommendation(ai_scores: AIScores, workload: str, event_value: int) str
    +generate_reason(recommendation: str, workload: str) str
    +generate_summary(ai_scores: AIScores, event_category: str, ai_reasoning: str, workload: str) dict
    +create_event_record(ai_scores: AIScores, event_category: str, ai_reasoning: str, event_name: str, event_description: str, workload: str, destination_postal_code: str, travel_snapshot: dict) EventRecord
    +profile_is_ready(profile: StudentProfile) bool
    +assess_travel(travel: dict, profile: StudentProfile) TravelResult
}

class DataManager {
    +str PROFILE_KEY$
    +str EVENTS_KEY$
    -PersistenceStrategy _storage
    -EventFilter _event_filter
    -AnalyticsReporter _analytics_reporter
    +set_storage(strategy: PersistenceStrategy) void
    +get_profile() StudentProfile
    +save_profile(profile: StudentProfile) void
    +update_profile(profile_data: dict) StudentProfile
    +get_events() list~EventRecord~
    +save_events(events: list~EventRecord~) void
    +add_event(record: EventRecord) list~EventRecord~
    +filter_events(keyword: str, recommended: str, min_score: int) list~EventRecord~
    +get_analytics_summary() dict
    +close() void
}

%% ====================================================================
%% 2. AI SERVICES & PROMPTING
%% ====================================================================

class GeminiClient {
    -str _api_key
    -str _model_name
    +is_available() bool
    +call(prompt: str) str
}

class PromptBuilder {
    +build_schema_instruction() str
    +build_analysis_prompt(profile: dict, name: str, description: str) str
}

%% ====================================================================
%% 3. DOMAIN ENTITIES
%% ====================================================================

class Entity {
    <<abstract>>
    +to_dict()* dict
    +clean_text(value: Any, name: str)$ str
    +check_score(value: Any, name: str)$ int
    +check_is_dict(data: Any, class_name: str)$ void
}

class StudentProfile {
    -str _field_of_study
    -list~str~ _interests
    -str _home_postal_code
    +field_of_study str
    +interests list~str~
    +home_postal_code str
    +has_interest(text: str) bool
    +add_interest(interest: str) void
    +remove_interest(interest: str) void
    +validate_singapore_postal_code(postal_code: str)$ str
    +is_empty() bool
    +to_dict() dict
    +from_dict(data: dict)$ StudentProfile
}

class EventRecord {
    -str _event_name
    -str _event_description
    -str _event_category
    -str _ai_reasoning
    -str _reason
    -str _recommendation
    -str _workload
    -AIScores _ai_scores
    -str _timestamp
    -int _event_value
    -str _priority
    -str _destination_postal_code
    -dict _travel_snapshot
    +event_name str
    +event_description str
    +event_category str
    +ai_reasoning str
    +reason str
    +recommendation str
    +workload str
    +ai_scores AIScores
    +timestamp str
    +event_value int
    +priority str
    +destination_postal_code str
    +travel_snapshot dict
    +to_dict() dict
    +from_dict(data: dict)$ EventRecord
}

class AIScores {
    -int _career_relevance
    -int _learning_value
    -int _networking_value
    +career_relevance int
    +learning_value int
    +networking_value int
    +total_value int
    +to_dict() dict
    +from_dict(data: dict)$ AIScores
}

%% ====================================================================
%% 4. BUSINESS RULES & SCORING
%% ====================================================================

class ScoringStrategy {
    <<interface>>
    +calculate(ai_scores: AIScores)* int
    +priority_for(value: int)* str
}

class StandardScoringStrategy {
    +calculate(ai_scores: AIScores) int
    +priority_for(value: int) str
}

class Rule {
    <<abstract>>
    +str recommendation
    +matches(ai_scores: AIScores, workload: str, event_value: int)* bool
    +get_recommendation() str
}

class TopScoresRule {
    +str recommendation
    +matches(ai_scores: AIScores, workload: str, event_value: int) bool
}

class HighValueLowWorkloadRule {
    +str recommendation
    +matches(ai_scores: AIScores, workload: str, event_value: int) bool
}

class HighValueHighWorkloadRule {
    +str recommendation
    +matches(ai_scores: AIScores, workload: str, event_value: int) bool
}

class MidValueLowWorkloadRule {
    +str recommendation
    +matches(ai_scores: AIScores, workload: str, event_value: int) bool
}

class MidValueHighWorkloadRule {
    +str recommendation
    +matches(ai_scores: AIScores, workload: str, event_value: int) bool
}

class LowValueRule {
    +str recommendation
    +matches(ai_scores: AIScores, workload: str, event_value: int) bool
}

class RuleEngine {
    -list~Rule~ _rules
    +add_rule(rule: Rule) void
    +evaluate(ai_scores: AIScores, workload: str, event_value: int) str
}

%% ====================================================================
%% 5. GEOLOCATION & TRANSIT ROUTING
%% ====================================================================

class TransitRoutingService {
    <<interface>>
    +ZoneInfo SINGAPORE_TIMEZONE$
    +validate_singapore_postal_code(postal_code: str)$ str
    +get_transit_route(origin_postal_code: str, destination_postal_code: str, departure_time: datetime)* TravelResult
}

class GeoLocationService {
    +str BASE_URL$
    -str _token
    -Callable _opener
    -float _timeout_seconds
    +get_transit_route(home_postal_code: str, destination_postal_code: str, departure_time: datetime) TravelResult
    -resolve_postal_code(postal_code: str) str
    -request_json(path: str, params: dict) dict
}

class JourneyPlanner {
    -TransitRoutingService _service
    -float _arrival_buffer_minutes
    -float _preferred_limit_minutes
    -Callable _clock
    +arrival_buffer_minutes float
    +preferred_limit_minutes float
    +evaluate(event_start: datetime, route: TravelResult) TravelResult
    +to_singapore_datetime(value: datetime, name: str)$ datetime
    +validate_number(value: float, name: str, allow_zero: bool)$ void
    +plan(origin_postal_code: str, destination_postal_code: str, event_start: datetime, enabled: bool) tuple
}

class TravelResult {
    +ZoneInfo SINGAPORE_TIMEZONE$
    -str _status
    -str _feasibility
    -float _arrival_buffer_minutes
    -float _distance_km
    -float _duration_minutes
    -datetime _departure_time
    -datetime _recommended_departure
    -datetime _estimated_arrival
    -str _provider
    -str _error_message
    -str _error_code
    -datetime _event_start
    -float _preferred_limit_minutes
    -list _legs
    +status str
    +feasibility str
    +arrival_buffer_minutes float
    +distance_km float
    +duration_minutes float
    +departure_time datetime
    +recommended_departure datetime
    +estimated_arrival datetime
    +provider str
    +error_message str
    +error_code str
    +event_start datetime
    +preferred_limit_minutes float
    +legs list
    +with_recommended_departure(departure: datetime) TravelResult
    +from_onemap_response(response: dict)$ TravelResult
    +to_dict() dict
}

%% ====================================================================
%% 6. PERSISTENCE & ANALYTICS
%% ====================================================================

class PersistenceStrategy {
    <<abstract>>
    +save(key: str, data: Any)* void
    +load(key: str)* Any
    +exists(key: str)* bool
    +close() void
}

class JsonStorage {
    -str _base_dir
    +save(key: str, data: Any) void
    +load(key: str) Any
    +exists(key: str) bool
}

class MongoStorage {
    -str _uri
    -MongoClient _client
    -Database _database
    -Collection _collection
    +save(key: str, data: Any) void
    +load(key: str) Any
    +exists(key: str) bool
    +close() void
}

class EventFilter {
    -list~EventRecord~ _events
    +events list~EventRecord~
    +filter_by_recommendation(recommendation: str, events: list) list~EventRecord~
    +filter_by_keyword(keyword: str, events: list) list~EventRecord~
    +filter_by_min_score(min_score: int, events: list) list~EventRecord~
    +filter(keyword: str, min_score: int, events: list, recommended: str) list~EventRecord~
}

class AnalyticsReporter {
    +tuple STANDARD_RECOMMENDATIONS$
    +tuple STANDARD_PRIORITIES$
    +tuple STANDARD_WORKLOADS$
    -list~EventRecord~ _events
    +events list~EventRecord~
    +total_events(events: list) int
    +category_distribution(events: list) dict
    +recommendation_breakdown(events: list) dict
    +attendance_rate(events: list) float
    +priority_distribution(events: list) dict
    +average_scores(events: list) dict
    +workload_vs_recommendation(events: list) dict
    +generate_summary(events: list) dict
}

